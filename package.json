{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "css:watch": "tailwindcss -i ./frontend/input.css -o ./public/output.css --watch",
        "css:build": "tailwindcss -i ./frontend/input.css -o ./public/output.css --minify",
        "frontend:dev": "concurrently \"npm run css:watch\" \"live-server frontend\"",
        "frontend:build": "npm run css:build"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "autoprefixer": "^10.4.20",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "live-server": "^1.2.2",
        "postcss": "^8.4.47",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.4"
    }
}
